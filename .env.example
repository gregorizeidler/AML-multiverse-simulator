# AML Multiverse Simulator v2 — environment variables
# Copy to .env and adjust as needed

# ── Simulation ──────────────────────────────────────────────
NUM_CUSTOMERS=2000
NUM_TRANSACTIONS=20000
ILLICIT_RATIO=0.05
RANDOM_SEED=42
NUM_WORKERS=4

# ── Paths ────────────────────────────────────────────────────
DATA_DIR=./data/output
RESULTS_DIR=./data/results

# ── LLM (optional) ───────────────────────────────────────────
# Set OPENAI_API_KEY for GPT-4o-mini powered SAR narratives,
# transaction explanations, and the AI chat assistant.
# Without this, a heuristic fallback is used automatically.
# OPENAI_API_KEY=sk-...

# Or use Ollama locally (no API key required):
# Start with: ollama serve && ollama pull llama3
# OLLAMA_MODEL=llama3

# ── API ──────────────────────────────────────────────────────
API_PORT=8000

# ── Frontend ─────────────────────────────────────────────────
VITE_PORT=5173
